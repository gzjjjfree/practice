在项目根目录下，创建以下目录和文件：
mkdir -p .agents/hooks
post-code-gen.sh

```
#!/bin/bash
# 每次 Qwen Code 生成或修改代码后，自动执行 Vite 项目的类型检查
echo "🤖 Qwen Code 正在自动验证代码..."
npx tsc --noEmit

# 检查 tsc 命令的退出状态码
if [ $? -eq 0 ]; then
    echo "✅ 验证通过：TypeScript 类型检查无误！"
else
    echo "❌ 验证失败：发现类型错误，请 Qwen Code 根据上述报错自动修复代码。"
    exit 1  # 返回非0状态码，触发 Qwen Code 的 PostToolUseFailure 钩子，让它自动重试修复
fi
```

chmod +x .agents/hooks/post-code-gen.sh

mkdir -p .qwen
settings.json

```
{
  "hooks": {
    "PostToolUse": [
      {
        "type": "command",
        "command": "bash .agents/hooks/post-code-gen.sh",
        "name": "auto-type-check",
        "description": "代码修改后自动运行 TypeScript 类型检查"
      }
    ]
  },
  "permissions": {
    "autoMode": {
      "hints": {
        "allow": [
          "Running TypeScript type check with tsc --noEmit",
          "Running npx tsc commands for project validation"
        ]
      }
    }
  }
}
```


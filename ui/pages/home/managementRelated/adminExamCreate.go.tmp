// renderLocalQuestions 渲染本地题库中的题目列表，按题型分组。
//
// 功能说明：
// 从本地题库中过滤题目，并按题型分组渲染题目卡片列表到 UI 容器中。
// 使用增量更新机制，保留上一帧的题目对象引用，只添加/移除变化的题目。
//
// 输入参数：
//   - ws: *AdminExamCreateState，管理员考试创建状态对象。
func renderLocalQuestions(ws *AdminExamCreateState) {
	// 保存上一帧的题目对象引用，用于增量更新
	if ws.qListVBox != nil && len(ws.qListVBox.Objects) > 0 {
		ws.oldQuestionObjects = make([]fyne.CanvasObject, len(ws.qListVBox.Objects))
		copy(ws.oldQuestionObjects, ws.qListVBox.Objects)
	}

	typeOrder := []string{"单选题", "多选题", "判断题", "填空题", "问答题"}
	groupedMap := make(map[string][]core.Question)
	for _, q := range ws.localQuestions {
		groupedMap[q.Type] = append(groupedMap[q.Type], q)
	}

	// 构建当前帧需要显示的题目对象集合
	currentObjects := make([]fyne.CanvasObject, 0)

	for _, qType := range typeOrder {
		if !ws.questionFilterTypes[qType] {
			continue
		}
		questions, ok := groupedMap[qType]
		if !ok || len(questions) == 0 {
			continue
		}

		section := buildGroupedSection(qType, questions, ws.selectedQIDs, ws, func() {
			refreshQuestionList(ws)
			updateQuestionSelectTitle(ws)
			// 刷新目标用户页状态（使用节流避免重复刷新）
			if ws.userPageRefreshFunc != nil {
				throttleFunc(ws.userPageRefreshFunc, 100)()
			}
		})
		currentObjects = append(currentObjects, section)
		currentObjects = append(currentObjects, container.NewGridWrap(fyne.NewSize(1, core.AdminListSpacingH8)))
	}

	// 如果没有题目，显示空数据提示
	if len(currentObjects) == 0 {
		noData := canvas.NewText(core.AdminNoQuestionsAvailableMsg, core.HexColor(core.TextMutedColor))
		noData.Alignment = fyne.TextAlignCenter
		noData.TextSize = core.AdminInfoTextSize
		currentObjects = append(currentObjects, noData)
	}

	// 增量更新：替换旧对象
	if ws.qListVBox != nil {
		// 使用 Swap 替换所有对象
		ws.qListVBox.Swap(currentObjects)

		// 移除旧对象中不再显示的题目（避免内存泄漏）
		for _, obj := range ws.oldQuestionObjects {
			ws.qListVBox.Remove(obj)
		}
	}

	// 清空上一帧引用
	ws.oldQuestionObjects = nil
}
